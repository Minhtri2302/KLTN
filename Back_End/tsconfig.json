{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
  "baseUrl": ".",
  "paths": {
  "@models/*": ["./src/models/*"],
  "@interfaces/*": ["./src/interface/*"],
  "@schemas/*": ["./src/schema/*"],
  "@routes/*": ["./src/route/*"]
}

  },
  "include": ["app.ts", "src/**/*"]
}
